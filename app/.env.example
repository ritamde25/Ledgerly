# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Flask YOLO Backend
FLASK_API_URL=http://10.0.2.2:5000

# Instructions:
# 1. Copy this file to .env (do not commit .env to version control)
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. You can find these values in your Supabase project settings
# 4. Set FLASK_API_URL to your backend host when testing on a physical device
