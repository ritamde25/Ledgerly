# Ledgerly YOLO Backend
# Copy this file to `.env` (the real `.env` is gitignored).

# Environment
# - Use `development` to load local weights from MODEL_PATH.
# - Any other value uses Hugging Face download mode.
APP_ENV=development

# Server
PORT=5000

# Local model (development only)
MODEL_PATH=best.pt

# Hugging Face download mode
# Required when using HF mode.
HF_MODEL_URL=

# Optional
HF_MODEL_FILENAME=best.pt
HF_MODEL_CACHE_DIR=.model_cache
